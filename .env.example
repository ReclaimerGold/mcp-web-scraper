# MCP server bind
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Scraping limits
SCRAPE_TIMEOUT_S=30
SCRAPE_MAX_BYTES=2097152
USER_AGENT=mcp-web-scraper/0.1.0

# Optional Bearer token for /mcp (leave empty for Odysseus; Odysseus cannot send this header)
MCP_API_KEY=

# Comma-separated Origin allowlist for Streamable HTTP, or * to disable DNS rebinding checks
ALLOWED_ORIGINS=*
