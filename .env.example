# MCP server bind
MCP_HOST=0.0.0.0
MCP_PORT=8000

# External Ollama (host machine from inside Docker)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:7b

# Scraping limits
SCRAPE_TIMEOUT_S=30
SCRAPE_MAX_BYTES=2097152
USER_AGENT=mcp-web-scraper/0.1.0

# Optional Bearer token for /mcp (leave empty to disable)
MCP_API_KEY=

# Comma-separated origins for Streamable HTTP, or * for all
ALLOWED_ORIGINS=*
